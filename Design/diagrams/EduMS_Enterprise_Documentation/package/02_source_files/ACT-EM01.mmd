flowchart TD
    Start([رصد حالة]) --> Type{نوع الحالة}
    Type -- صحية --> H1[تفعيل الإسعاف]
    Type -- حريق --> F1[تفعيل الإخلاء]
    Type -- زلزال --> Q1[التحرك إلى نقطة آمنة]
    Type -- أمنية --> S1[الإغلاق]
    H1 --> N[إشعار الطوارئ]
    F1 --> N
    Q1 --> N
    S1 --> N
    N --> O[إشعار المكتب]
    O --> Damage[تقييم الأضرار]
    Damage --> Inj{إصابات؟}
    Inj -- نعم --> Hosp[نقل للمستشفى]
    Inj -- لا --> Cont[متابعة الإجراءات]
    Hosp --> Recover[خطة التعويض]
    Cont --> Recover
    Recover --> Report[تقرير الحادثة]
    Report --> Lessons[الدروس المستفادة]
    Lessons --> End([انتهاء])