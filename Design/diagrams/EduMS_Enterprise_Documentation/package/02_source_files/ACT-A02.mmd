flowchart TD
    Start([بدء العام]) --> P[إعداد الخطة]
    P --> SC[توزيع لجان الجرد]
    SC --> N[إشعار الأقسام]
    N --> EX[تنفيذ الجرد الميداني<br/>قراءة الباركود]
    EX --> M[مطابقة مع النظام]
    M --> D{فروقات؟}
    D -- لا --> AP[اعتماد]
    D -- نعم --> I[تحليل السبب]
    I --> R{السبب}
    R -- خطأ ترقيم --> F1[تصحيح]
    R -- مفقود --> L[بلاغ مفقودات]
    R -- زيادة --> AD[تسجيل أصل جديد]
    L --> INV[تحقيق]
    F1 --> AP
    AD --> AP
    INV --> AP
    AP --> S[توقيع لجنة الجرد]
    S --> SUB[رفع للإدارة]
    SUB --> End([انتهاء])