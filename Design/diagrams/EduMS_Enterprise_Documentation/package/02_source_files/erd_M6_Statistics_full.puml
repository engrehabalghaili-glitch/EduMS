  kpiNameAr : VARCHAR(200)
  kpiNameEn : VARCHAR(200)
  kpiDescription : TEXT
  sourceModule : VARCHAR(200)
  sourceTable : VARCHAR(200)
  sourceField : VARCHAR(200)
  aggregationMethod : INT
  chartType : VARCHAR(50)
  refreshInterval : VARCHAR(200)
  targetValue : VARCHAR(200)
  thresholdGreen : VARCHAR(200)
  thresholdYellow : VARCHAR(200)
  thresholdRed : VARCHAR(200)
