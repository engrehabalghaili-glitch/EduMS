  alertRecipients : VARCHAR(200)
  isActive : BOOLEAN
  displayOrder : VARCHAR(200)
  dashboardId : BIGINT <<FK>>
  createdByUserId : BIGINT <<FK>>
  updatedByUserId : BIGINT <<FK>>
  createdAt : DATE
  updatedAt : DATE
  isDeleted : BOOLEAN
}

